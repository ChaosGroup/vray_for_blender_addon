{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "VBlender json schema",
    "type": "object",
    "patternProperties": { "^//": {} },
    "additionalProperties": false,
    "$defs": {
        "paramType": {
            "type": "string",
            "enum": [
                "INT",
                "BOOL",
                "FLOAT",
                "ENUM",
                "STRING",
                "TRANSFORM",
                "GEOMETRY",
                "MATRIX",
                "MATRIX_TEXTURE",
                "FLOAT_TEXTURE",
                "INT_TEXTURE",
                "INCLUDE_EXCLUDE_LIST",
                "TEMPLATE",
                "PLUGIN_LIST",
                "ROLLOUT",
                "BRDF",
                "UVWGEN",
                "VECTOR",
                "BRDF_USE",
                "TEXTURE",
                "COLOR_TEXTURE",
                "PLUGIN",
                "EFFECT",
                "OBJECT",
                "COLOR",
                "COLOR_USE",
                "OUTPUT_PLUGIN",
                "OUTPUT_TEXTURE",
                "OUTPUT_FLOAT_TEXTURE",
                "INT_LIST",
                "ACOLOR",
                "BOOL_LIST",
                "COLOR_LIST",
                "FLOAT_LIST",
                "FLOAT_TEXTURE_LIST",
                "GRAD_RAMP",
                "INDEX_VECTOR_4",
                "LIST",
                "LIST_LIST",
                "MAPCHANNEL_LIST",
                "MATERIAL",
                "OUTPUT_COLOR",
                "OUTPUT_INT_TEXTURE",
                "OUTPUT_TRANSFORM_TEXTURE",
                "OUTPUT_VECTOR_TEXTURE",
                "RENDERCHANNEL",
                "STRING_LIST",
                "TEXTURE_LIST",
                "TRANSFORM_LIST",
                "TRANSFORM_TEXTURE",
                "VECTOR_LIST",
                "VECTOR_TEXTURE"
            ]
        },
        "multiRuleCondition": {
            "description": "A multi-rule condition.",
            "type": "object",
            "properties": {
                "cond": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                }
            },
            "required": ["cond"]
        },
        "singleRuleCondition": {
            "description": "A single-rule condition.",
            "type": "object",
            "properties": {
                "cond": {
                    "type": "string"
                }
            },
            "required": ["cond"]
        },
        "widgetsArray": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "comment": {
                        "type": "string"
                    },
                    "use_prop": {
                        "type": "string"
                    },
                    "layout": {
                        "type": "string",
                        "enum": [ "ROLLOUT", "COLUMN", "SEPARATOR", "ROW", "BOX" ]
                    },
                    "search_bar_for": {"type": "string"},
                    "align": {
                        "type": "boolean"
                    },
                    "name": {
                        "type": "string"
                    },
                    "label": {
                        "oneOf": [
                            { "type": "string" },
                            { "$ref": "#/$defs/multiRuleCondition" }
                        ]
                    },
                    "default_closed": {
                        "type": "boolean"
                    },
                    "active": {
                        "oneOf": [
                            {"type": "boolean"},
                            {"$ref": "#/$defs/singleRuleCondition" }
                        ]
                    },
                    "visible": {
                        "oneOf": [
                            {"type": "boolean"},
                            {"$ref": "#/$defs/singleRuleCondition" }
                        ]
                    },
                    "expand": {
                        "type": "boolean"
                    },
                    "custom_draw": {
                        "type": "string"
                    },
                    "list_label": {
                        "type": "string"
                    },
                    "draw_container": {
                        "type": "string",
                        "enum": [
                            "ROLLOUT"
                        ]
                    },
                    "slider": {
                        "type": "boolean"
                    },
                    "attrs": {
                        "$ref": "#/$defs/widgetsArray"
                    },
                    "panel_prop": {
                        "type": "object",
                        "properties": {
                            "wm_data": { "type": "string" },
                            "name": { "type": "string" }
                        },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "properties": {
        "Type": {
            "type": "string",
            "enum": [
                "OBJECT",
                "MISC",
                "EFFECT",
                "SETTINGS",
                "TEXTURE",
                "CAMERA",
                "UVWGEN",
                "SYSTEM",
                "GEOMETRY",
                "RENDERCHANNEL",
                "BRDF",
                "LIGHT",
                "MATERIAL",
                "VOLUMETRIC"
            ]
        },
        "BASE": {
            "type": "string"
        },
        "ID": {
            "type": "string"
        },
        "Desciption": {
            "type": "string"
        },
        "Description": {
            "type": "string"
        },
        "Name": {
            "type": "string"
        },
        "Category": {
            "type": "string",
            "enum": [ "FLOAT_TEXTURE" ]
        },
        "Subtype": {
            "type": "string",
            "enum": [
                "SPECIAL",
                "ADVANCED",
                "GEOMETRY",
                "MATTE",
                "UTILITY",
                "XYZ"
            ]
        },
        "Parameters": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "items_disabled_in_CE": {"type": "array", "items": {"type": "string"}},
                    "items_disabled_in_CE_tooltip": {"type": "string"},
                    "default_in_CE": {},
                    "attr": {
                        "type": "string"
                    },
                    "default": {},
                    "subtype": {
                        "type": "string",
                        "enum": [
                            "FACTOR",
                            "ANGLE",
                            "FILE_PATH",
                            "DIR_PATH",
                            "COLOR",
                            "PERCENTAGE",
                            "XYZ",
                            "DISTANCE",
                            "DISTANCE_CAMERA",
                            "VRAY_ROTATION",
                            "VRAY_OFFSET",
                            "VRAY_FILE_PATH",
                            "NONE"
                        ]
                    },
                    "precision": {
                        "type": "integer"
                    },
                    "type": {
                        "$ref": "#/$defs/paramType"
                    },
                    "inclusion_mode_prop": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "desc": {
                        "type": "string"
                    },
                    "elements_count": {
                        "type": "integer"
                    },
                    "update": {
                        "type": "string"
                    },
                    "color_prop": {
                        "type": "string"
                    },
                    "tex_prop": {
                        "type": "string"
                    },
                    "use_tex_prop": {
                        "type": "string"
                    },
                    "bound_props": {
                        "type": "object",
                        "additionalProps": false,
                        "properties": {
                            "target_prop": {
                                "type": "string"
                            },
                            "use_prop": {
                                "type": "string"
                            }
                        }
                    },
                    "get": {
                        "type": "string"
                    },
                    "set": {
                        "type": "string"
                    },
                    "comment": {
                        "type": "string"
                    },
                    "ui": {
                        "type": "object",
                        "patternProperties": { "^//": {} },
                        "additionalProperties": false,
                        "properties": {
                            "file_names": {"type": "array", "items": {"type": "string"}},
                            "file_op": {"type": "string"},
                            "gpuSupport": {
                                "type": "string",
                                "enum": [ "full", "none" ]
                            },
                            "rollout": {
                                "type": "string"
                            },
                            "tab": {
                                "type": "string"
                            },
                            "display_name": {
                                "type": "string"
                            },
                            "file_extensions": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            },
                            "attributes": {
                                "type": "array"
                            },
                            "quantityType": {
                                "type": "string",
                                "enum": [
                                    "distance",
                                    "angle"
                                ]
                            },
                            "units": {
                                "type": "string",
                                "enum": [
                                    "radians",
                                    "degrees",
                                    "meters",
                                    "centimeters",
                                    "millimeters"
                                ]
                            },
                            "soft_min": {
                                "type": ["number", "null"],
                                "description": "null means no limit - Blender's own property default applies instead of clamping."
                            },
                            "soft_max": {
                                "type": ["number", "null"],
                                "description": "null means no limit - Blender's own property default applies instead of clamping."
                            },
                            "min": {
                                "type": ["number", "null"],
                                "description": "null means no limit - Blender's own property default applies instead of clamping."
                            },
                            "max": {
                                "type": ["number", "null"],
                                "description": "null means no limit - Blender's own property default applies instead of clamping."
                            },
                            "spin_step": {
                                "type": "number"
                            },
                            "file_extensions": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "filter_type": {
                        "type": "string",
                        "enum": [ "geometry" ]
                    },
                    "options": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "skipUnitScale": {"type": "boolean"},
                            "spin_step": {"type": "number"},
                            "value_conv_factor": {
                                "type": "number"
                            },
                            "linked_only": {
                                "type": "boolean"
                            },
                            "shadowed": {
                                "type": "boolean"
                            },
                            "derived": {
                                "type": "boolean"
                            },
                            "cross_dependency": {
                                "type": "boolean"
                            },
                            "animatable": {
                                "type": "boolean"
                            },
                            "visible": {
                                "type": "boolean"
                            },
                            "link_info": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "link_type": {
                                        "type": "string",
                                        "enum": [
                                            "OBJECTS"
                                        ]
                                    },
                                    "filter_function": {
                                        "type": "string"
                                    }
                                }
                            },
                            "template": {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "type": {
                                        "type": "string",
                                        "enum": [
                                            "templateIncludeExclude",
                                            "templateMultiObjectSelect",
                                            "templateSingleObjectSelect",
                                            "templateFileSelect",
                                            "templateColorTemperature",
                                            "templateProxyObjectHierarchy"
                                        ]
                                    },
                                    "custom_exporter": {
                                        "type": "boolean"
                                    },
                                    "args": {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "properties": {
                                            "bound_property": {
                                                "type": "string"
                                            },
                                            "mode_bound_property": {
                                                "type": "string"
                                            },
                                            "filter_function": {
                                                "type": "string"
                                            },
                                            "collection": {
                                                "type": "string"
                                            },
                                            "object_type": {
                                                "type": "string"
                                            },
                                            "color_mode": {
                                                "type": "string"
                                            },
                                            "color_bound_property": {
                                                "type": "string"
                                            },
                                            "temperature_bound_property": {
                                                "type": "string"
                                            },
                                            "file_property": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "array",
                            "items": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "string"
                                }
                            ],
                            "minItems": 3,
                            "maxItems": 3
                        }
                    }
                },
                "required": [
                    "attr"
                ],
                "patternProperties": { "^//": {} },
                "additionalProperties": false
            }
        },
        "Widget": {
            "type": "object",
            "patternProperties": { "^//": {} },
            "additionalProperties": false,
            "properties": {
                "npanel": {"$ref": "#/$defs/widgetsArray"},
                "render_mask": {"$ref": "#/$defs/widgetsArray"},
                "widgets": {
                    "$ref": "#/$defs/widgetsArray"
                },
                "sidebar": {
                    "$ref": "#/$defs/widgetsArray"
                }
            },
            "required": [
                "widgets"
            ]
        },
        "Node": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "widgets": {
                    "$comment": "Same shape as Widget.widgets. UIPainter.renderWidget() draws both, so a node section can nest containers and carry labels and conditions as well.",
                    "$ref": "#/$defs/widgetsArray"
                },
                "output_sockets": {
                    "type": "array",
                    "additionalItems": false,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "label": {
                                "type": "string"
                            },
                            "type": {
                                "$ref": "#/$defs/paramType"
                            },
                            "visible": {
                                "type": "boolean"
                            },
                            "desc": {
                                "type": "string"
                            }
                        }
                    }
                },
                "input_sockets": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "label": {
                                "oneOf": [
                                    { "type": "string" },
                                    { "$ref": "#/$defs/multiRuleCondition" }
                                ]
                            },
                            "type": {
                                "$ref": "#/$defs/paramType"
                            },
                            "visible": {
                                "oneOf": [
                                    { "type": "boolean" },
                                    { "$ref": "#/$defs/singleRuleCondition" }
                                ]
                            },
                            "active": {
                                "oneOf": [
                                    { "type": "boolean" },
                                    { "$ref": "#/$defs/singleRuleCondition" }
                                ]
                            },
                            "desc": {
                                "type": "string"
                            },
                            "default_closed": {
                                "type": "boolean"
                            },
                            "link_redirect": {
                                "type": "string",
                                "description": "For a ROLLOUT socket: the name of a grouped param socket that a link dropped on the collapsed rollout header is forwarded to. The rollout auto-expands to reveal the connection."
                            }
                        }
                    }
                },
                "internal_links": {
                    "type": "object",
                    "additionalProperties": false,
                    "patternProperties": {
                        "^.*$": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "Options": {
            "type": "object",
            "patternProperties": { "^//": {} },
            "additionalProperties": false,
            "properties": {
                "animatable": {
                    "type": "boolean"
                },
                "use_factor_subtype": {
                    "type": "boolean"
                },
                "excluded_parameters": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "use_animation_layout": {
                    "type": "boolean"
                }
            }
        }
    }
}