{
    "ID": "SettingsOutput",
    "Parameters": [
        {
            "attr" : "img_file",
            "desc" : "Output image filename. Supports placeholder expansion.",
            "type" : "STRING"
        },
        {
            "attr": "img_dir",
            "desc": "Output image directory. Supports placeholder expansion.",
            "subtype": "DIR_PATH"
        },
        {
            "attr": "img_format",
            "desc": "Output image format",
            "items": [
                [
                    "0",
                    "PNG",
                    ""
                ],
                [
                    "1",
                    "JPEG",
                    ""
                ],
                [
                    "2",
                    "TIFF",
                    ""
                ],
                [
                    "3",
                    "TGA",
                    ""
                ],
                [
                    "4",
                    "SGI",
                    ""
                ],
                [
                    "5",
                    "OpenEXR",
                    ""
                ],
                [
                    "6",
                    "VRayImage",
                    "V-Ray Image Format"
                ]
            ],
            "default": "1",
            "name": "Image Format",
            "type": "ENUM",
            "items_disabled_in_CE": ["6", "5"],
            "items_disabled_in_CE_tooltip": "V-Ray for Blender - Community Edition does not support saving to this file format.",
            "options": {
                "derived": true
            }
        },
        {
            "attr": "relements_separateFiles",
            "name": "Separate Files",
            "desc": "Save render channels in separate files",
            "type": "BOOL",
            "default": true,
            "options": {
                "derived": true
            }
        },
        {
            "attr": "output_overwrite_warn",
            "default": true,
            "desc": "Show warning dialog when rendered images will be overwritten",
            "type": "BOOL",
            "options": {
                "derived": true
            }
        },
        {
            "attr": "resumable_rendering",
            "default": false,
            "desc": "Saves the rendering progress or resumes rendering if a resumable file is found",
            "name": "Resumable Rendering",
            "type": "BOOL",
            "options": {
                "derived": true
            }
        },
        {
            "attr": "resumable_delete_on_success",
            "default": false,
            "desc": "Automatically deletes the resumable file after the frame completes successfully",
            "name": "Delete on Success",
            "type": "BOOL",
            "options": {
                "derived": true
            }
        },
        {
            "attr": "resumable_autosave_interval",
            "default": 0.0,
            "desc": "Interval in minutes, at which to save the resumable file for progressive rendering. If set to 0, the file will only be saved at the end",
            "name": "Autosave Interval (min.)",
            "type": "FLOAT",
            "options": {
                "derived": true
            }
        }
    ],
    "Options": {
        "excluded_parameters": [],
        "animatable": false
    }
