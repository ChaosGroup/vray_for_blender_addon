{
    "ID": "UVWGenEnvironment",
    "Parameters": [
        {
            "attr": "mapping_type",
            "items": [
                [ "angular", "Angular", "Angular map, as used by light probe images" ],
                [ "cubic", "Cubic", "Cubic environment map" ],
                [ "spherical", "Spherical", "Spherical environment map" ],
                [ "mirror_ball", "Mirror Ball", "Mirror ball image" ],
                [ "screen", "Screen", "The environment is projected onto the screen" ],
                [ "max_spherical", "Spherical (3ds Max)", "Spherical mapping matching 3ds Max" ],
                [ "spherical_vray", "Spherical (V-Ray)", "Spherical mapping matching V-Ray for 3ds Max" ],
                [ "max_cylindrical", "Cylindrical (3ds Max)", "Cylindrical mapping matching 3ds Max" ],
                [ "max_shrink_wrap", "Shrink Wrap (3ds Max)", "Shrink wrap mapping matching 3ds Max" ],
                [ "max_world_xyz", "World XYZ (3ds Max)", "World XYZ mapping matching 3ds Max" ]
            ],
            "ui": {
                "display_name": "Mapping Type"
            }
        },
        {
            "attr" : "ground_on",
            "default" : false,
            "type" : "BOOL"
        },
        {
            "attr": "uvw_transform",
            "ui" : {
                "display_name": "UVW Transform"
            }
        },
        {
            "attr": "ground_radius",
            "ui" : {
                "min": 0.001,
                "max": 1000000
            }
        },
        {
            "attr": "duvw_scale",
            "ui" : {
                "soft_min": 0.01,
                "soft_max": 100.0
            }
        }
    ],
    "Widget": {
        "widgets": [
            {
                "layout": "COLUMN",
                "attrs": [
                    {
                        "name": "mapping_type"
                    },
                    {
                        "name": "wrap_u"
                    },
                    {
                        "name": "wrap_v"
                    },
                    {
                        "name": "wrap_w"
                    },
                    {
                        "name": "crop_u"
                    },
                    {
                        "name": "crop_v"
                    },
                    {
                        "name": "crop_w"
                    },
                    {
                        "name": "duvw_scale",
                        "label": "Filter Multiplier"
                    },
                    {
                        "name": "ground_on",
                        "label": "Ground"
                    },
                    {
                        "name": "ground_radius",
                        "active":{
                            "cond":"::ground_on=1"
                        }
                    }
                ]
            }
        ]
    },
    "Node": {
        "widgets": [
            {
                "layout": "COLUMN",
                "attrs": [
                    {
                        "name": "mapping_type"
                    }
                ]
            }
        ],
        "input_sockets": [
            {
                "name": "uvw_transform"
            },
            {
                "name": "uvw_matrix",
                "label": "Environment Transform"
            }
        ]
    },
    "Options": {
        "excluded_parameters": [],
        "animatable": true
    }
}