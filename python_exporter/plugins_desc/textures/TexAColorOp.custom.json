{
    "ID": "TexAColorOp",
    "Name": "V-Ray Color Arithmetic",
    "Subtype": "UTILITY",
    "Parameters": [
        {
            "attr" : "mode",
            "default" : "0",
            "desc" : "The operation feeding the node's Result output. A is Color A * Mult A, B is Color B * Mult B",
            "items" :
            [
                [ "0", "Result A", "Value of A: Color A * Mult A" ],
                [ "1", "Result B", "Value of B: Color B * Mult B" ],
                [ "2", "Product", "Product: A * B" ],
                [ "3", "Sum", "Sum: A + B" ],
                [ "4", "Difference", "Difference: A - B" ],
                [ "5", "Power", "Power: A raised to the scalar Mult B" ],
                [ "6", "Division", "Division: A / B" ],
                [ "7", "Min", "min(A, B)" ],
                [ "8", "Max", "max(A, B)" ],
                [ "9", "Absolute difference", "Absolute value of the difference: abs(A - B)" ],
                [ "10", "Lower Intensity Color", "Value of the color with lower intensity" ],
                [ "11", "Greater Intensity Color", "Value of the color with greater intensity" ],
                [ "12", "Sin", "Sine of the product: sin(A * B)" ],
                [ "13", "Cos", "Cosine of the product: cos(A * B)" ],
                [ "14", "Abs", "Absolute value: abs(A)" ],
                [ "15", "Ceil", "Round up: ceil(A)" ],
                [ "16", "Exp", "Exponent: e^A" ],
                [ "17", "Floor", "Round down: floor(A)" ],
                [ "18", "Log", "Natural logarithm: ln(A)" ],
                [ "19", "Log10", "Log10: log(A)" ],
                [ "20", "Sqrt", "Square Root of A" ],
                [ "21", "Fmod", "Remainder of division: A % B" ],
                [ "22", "Average", "Average: (A + B) / 2" ],
                [ "23", "Tan", "Tangent: tan(A)" ],
                [ "24", "Asin", "Arcsine of the product: asin(A * B)" ],
                [ "25", "Acos", "Arccosine of the product: acos(A * B)" ],
                [ "26", "Atan", "Arctangent of the product: atan(A * B)" ],
                [ "27", "Atan 2", "Arctangent of B / A: atan2(B, A)" ],
                [ "28", "Bias Schlick", "Bias(A, B) as defined by Christophe Schlick" ],
                [ "29", "Gain Schlick", "Gain(A, B) as defined by Christophe Schlick" ],
                [ "30", "Bias Perlin", "Bias(A, B) as defined by Kenneth Perlin" ],
                [ "31", "Gain Perlin", "Gain(A, B) as defined by Kenneth Perlin" ]
            ],
            "type" : "ENUM",
            "update": "onUpdateMode",
            "ui" : {}
        },
        {
            "attr" : "color_a",
            "default" : [ 1.0, 1.0, 1.0, 1.0 ]
        },
        {
            "attr" : "color_b",
            "default" : [ 1.0, 1.0, 1.0, 1.0 ]
        },
        {
            "attr" : "result_alpha",
            "default" : 1.0
        },
        {
            "attr": "result",
            "default" : [0.0, 0.0, 0.0, 0.0],
            "desc" : "Result of the applying the operation to inputs A and B",
            "type" : "OUTPUT_TEXTURE",
            "ui" : {},
            "options": {
                "derived": true
            }
        },
        {
            "attr": "outputs",
            "type": "ENUM",
            "desc": "Output socket to show or hide",
            "default": "red",
            "items": [
                ["red",                   "Red",                   "Red channel of Color A * Mult A"],
                ["green",                 "Green",                 "Green channel of Color A * Mult A"],
                ["blue",                  "Blue",                  "Blue channel of Color A * Mult A"],
                ["alpha",                 "Alpha",                 "Alpha channel of Color A * Mult A"],
                ["intensity",             "Intensity",             "Intensity of Color A * Mult A"],
                ["result_a",              "Result A",              "Color A * Mult A"],
                ["result_b",              "Result B",              "Color B * Mult B"],
                ["sum",                   "Sum",                   "A + B"],
                ["difference",            "Difference",            "A - B"],
                ["absolute_difference",   "Absolute Difference",   "abs(A - B)"],
                ["product",               "Product",               "A * B"],
                ["division",              "Division",              "A / B"],
                ["power",                 "Power",                 "A raised to the scalar Mult B"],
                ["minimum",               "Minimum",               "min(A, B)"],
                ["maximum",               "Maximum",               "max(A, B)"],
                ["average",               "Average",               "(A + B) / 2"],
                ["lower_intensity_color", "Lower Intensity Color", "Color with lower intensity"],
                ["greater_intensity_color","Greater Intensity Color","Color with greater intensity"],
                ["sin",                   "Sin",                   "sin(A * B)"],
                ["cos",                   "Cos",                   "cos(A * B)"],
                ["tan",                   "Tan",                   "tan(A)"],
                ["asin",                  "Asin",                  "asin(A * B)"],
                ["acos",                  "Acos",                  "acos(A * B)"],
                ["atan",                  "Atan",                  "atan(A * B)"],
                ["atan2",                 "Atan2",                 "atan2(B, A)"],
                ["abs",                   "Abs",                   "abs(A)"],
                ["ceil",                  "Ceil",                  "ceil(A)"],
                ["exp",                   "Exp",                   "exp(A)"],
                ["floor",                 "Floor",                 "floor(A)"],
                ["log",                   "Log",                   "log(A)"],
                ["log10",                 "Log10",                 "log10(A)"],
                ["sqrt",                  "Sqrt",                  "sqrt(A)"],
                ["fmod",                  "Fmod",                  "A % B"],
                ["bias_schlick",          "Bias Schlick",          "Bias (Schlick approximation)"],
                ["gain_schlick",          "Gain Schlick",          "Gain (Schlick approximation)"],
                ["bias_perlin",           "Bias Perlin",           "Bias (Perlin definition)"],
                ["gain_perlin",           "Gain Perlin",           "Gain (Perlin definition)"]
            ],
            "options": {
                "derived": true
            }
        },
        {
            "attr": "internal_separate",
            "type": "STRING",
            "default": "",
            "desc": "Helper used by the 'Separate Color' menu entry to expose the RGBA channel outputs on creation",
            "update": "onUpdateSeparate",
            "options": {
                "derived": true
            }
        }
    ],
    "Widget": {
        "widgets": [
            {
                "layout": "COLUMN",
                "attrs": [
                    {
                        "name": "mode"
                    },
                    {
                        "layout": "SEPARATOR"
                    },
                    {
                        "name": "color_a",
                        "active": {"cond": "plugins.texture.TexAColorOp.isColorAActive"}
                    },
                    {
                        "name": "mult_a",
                        "label": "Multiplier A",
                        "active": {"cond": "plugins.texture.TexAColorOp.isMultAActive"}
                    },
                    {
                        "name": "color_b",
                        "active": {"cond": "plugins.texture.TexAColorOp.isColorBActive"}
                    },
                    {
                        "name": "mult_b",
                        "label": "Multiplier B",
                        "active": {"cond": "plugins.texture.TexAColorOp.isMultBActive"}
                    }
                ]
            }
        ]
    },
    "Node": {
        "widgets": [
            {
                "layout": "COLUMN",
                "attrs": [
                    {
                        "name": "mode"
                    }
                ]
            }
        ],
        "input_sockets": [
            { "name": "color_a"      },
            { "name": "mult_a"       },
            { "name": "color_b"      },
            { "name": "mult_b"       },
            { "name": "result_alpha" }
        ],
        "output_sockets":[
            {
                "label": "Result",
                "name": "_default_",
                "type": "OUTPUT_TEXTURE"
            },
            { "label": "Red", "name": "red", "visible": false },
            { "label": "Green", "name": "green", "visible": false },
            { "label": "Blue", "name": "blue", "visible": false },
            { "label": "Alpha", "name": "alpha", "visible": false },
            { "label": "Intensity", "name": "intensity", "visible": false },
            { "label": "Average", "name": "average", "visible": false },
            { "label": "Sum", "name": "sum", "visible": false },
            { "label": "Product", "name": "product", "visible": false },
            { "label": "Difference", "name": "difference", "visible": false },
            { "label": "Absolute Difference", "name": "absolute_difference", "visible": false },
            { "label": "Lower Intensity Color", "name": "lower_intensity_color", "visible": false },
            { "label": "Greater Intensity Color", "name": "greater_intensity_color", "visible": false },
            { "label": "Minimum", "name": "minimum", "visible": false },
            { "label": "Maximum", "name": "maximum", "visible": false },
            { "label": "Result A", "name": "result_a", "visible": false },
            { "label": "Result B", "name": "result_b", "visible": false },
            { "label": "Division", "name": "division", "visible": false },
            { "label": "Power", "name": "power", "visible": false },
            { "label": "Sin", "name": "sin", "visible": false },
            { "label": "Cos", "name": "cos", "visible": false },
            { "label": "Asin", "name": "asin", "visible": false },
            { "label": "Acos", "name": "acos", "visible": false },
            { "label": "Tan", "name": "tan", "visible": false },
            { "label": "Atan", "name": "atan", "visible": false },
            { "label": "Atan2", "name": "atan2", "visible": false },
            { "label": "Abs", "name": "abs", "visible": false },
            { "label": "Ceil", "name": "ceil", "visible": false },
            { "label": "Exp", "name": "exp", "visible": false },
            { "label": "Floor", "name": "floor", "visible": false },
            { "label": "Log", "name": "log", "visible": false },
            { "label": "Log10", "name": "log10", "visible": false },
            { "label": "Sqrt", "name": "sqrt", "visible": false },
            { "label": "Fmod", "name": "fmod", "visible": false },
            { "label": "Bias Schlick", "name": "bias_schlick", "visible": false },
            { "label": "Gain Schlick", "name": "gain_schlick", "visible": false },
            { "label": "Bias Perlin", "name": "bias_perlin", "visible": false },
            { "label": "Gain Perlin", "name": "gain_perlin", "visible": false }
        ],
        "internal_links": {
            "*" : ["Color A", "Color B"]
        }
    }
}