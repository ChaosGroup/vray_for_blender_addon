// Outlines. A BRDFToonOverride draws no lines by itself - the lines come from a scene-level
// VolumeVRayToon, exactly as world_export._exportToonOutlinesVolume adds one to a real scene
// whose material uses the Outlines socket. toonMaterialOnly=2 is what makes it safe to leave
// switched on for every thumbnail: it only outlines objects whose material actually carries a
// toon override, so nothing else in the tier list is affected.
VolumeVRayToon thumbOutlinesToon {
  toonMaterialOnly=2;
}

SettingsEnvironment thumbEnvironment {
  environment_volume=List(thumbOutlinesToon);
}

// Toon BRDF thumbnails. BRDFToonMtl picks its diffuse ramp colour from the summed direct light
// intensity. Under the two area lights that sum is noisy and stays well below 1, so render.py
// swaps them for this light. It has CircularLight's direction and intensity 1, so N.L covers the
// whole ramp.
LightDirect thumbToonLight {
  enabled=0;
  shadowBias=0.005;
  transform=Transform(Matrix(Vector(0.5232228, -0.2221448, -0.822733), Vector(0.6480597, 0.7306544, 0.2148553), Vector(0.5534045, -0.6455973, 0.5262581)), Vector(0.9255856871604919, -1.160173892974854, 1.003359913825989));
}

