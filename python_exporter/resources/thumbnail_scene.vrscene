// The flat swatch for the texture tier: a quad perpendicular to the camera axis that fills
// the frame exactly, with a 0..1 UV channel so a UV-space texture lands undistorted, one tile
// edge to edge. Placed off the world axes on purpose - a quad lying in a world plane makes one
// axis of a planar/object projection constant, which collapses those previews to a flat tone.
GeomStaticMesh thumbPlaneGeom {
  vertices=ListVector(Vector(0, 0, 0), Vector(1, 0, 0), Vector(1, 1, 0), Vector(0, 1, 0));
  faces=ListInt(0, 1, 2, 0, 2, 3);
  normals=ListVector(Vector(0, 0, 1));
  faceNormals=ListInt(0, 0, 0, 0, 0, 0);
  face_mtlIDs=ListInt(0, 0);
  map_channels=List(
    List(0, ListVector(Vector(0, 0, 0), Vector(1, 0, 0), Vector(1, 1, 0), Vector(0, 1, 0)), ListInt(0, 1, 2, 0, 2, 3))
  );
  map_channels_names=ListString("UVMap");
  dynamic_geometry=0;
  osd_subdiv_enable=0;
}

// The placement lives here, not in the vertices. UVWGenObject and friends map from OBJECT space,
// so vertices carrying the world placement made object space start at the quad's world position
// and the swatch showed an arbitrary offset slice of a tiled texture. Local coordinates span
// [0, 1] instead, which is exactly one tile: the scale is in this matrix and the offset puts
// local (0, 0) at the quad's lower-left corner. World positions are unchanged to within 1e-5, so
// world-space projections and the camera framing are unaffected.
Node thumbPlaneNode {
  transform=Transform(Matrix(Vector(-8.74228e-08, 2, 0), Vector(-1.09547, -4.78845e-08, 1.6733), Vector(0.836652, 3.65712e-08, 0.547735)), Vector(-3.75775, -0.999082, -3.53519));
  geometry=thumbPlaneGeom;
  material=thumbMtl;
  visible=0;
}

// A probe for TexDistance to measure to: present as geometry, invisible to every ray. The node
